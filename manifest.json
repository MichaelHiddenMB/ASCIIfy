{
  "manifest_version": 3,
  "name": "AASCIfy",
  "version": "0.1.0",
  "description": "Turns your new tab into a living, animated ASCII art scene.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "search"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
